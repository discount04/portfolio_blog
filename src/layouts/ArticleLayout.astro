---
import BaseLayout from './BaseLayout.astro';
import '../styles/article.css';
const { title, description, date, category, cover } = Astro.props;
---

<BaseLayout title={`${title} — KORI`} description={description}>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow">{category} · {date}</p>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
    </header>
    {cover && <img class="article-cover" src={cover} alt="" />}
    <div class="article-body"><slot /></div>
  </article>
</BaseLayout>
