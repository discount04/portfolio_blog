 65%);mix-blend-mode:screen;animation:shimmer 12s ease-in-out infinite}.home nav{position:absolute;z-index:8;top:.45%;right:4.15%;display:grid;justify-items:end;gap:1.05vw}.home nav img{display:block;height:auto}.home nav a:nth-child(1) img{width:5.1vw}.home nav a:nth-child(2) img{width:8vw}.home nav a:nth-child(3) img{width:4.6vw}.home nav a:nth-child(4) img{width:6.7vw}.copy{position:absolute;z-index:2;width:calc(28% * .88);left:5.5%;top:41%;transform:translate(calc(var(--px)*-.18),calc(var(--py)*-.18));transition:transform .9s ease}.identity{position:absolute;z-index:3;margin:0;padding:0;border:0;background:transparent;transition:transform 1s ease}.identity img{display:block;width:100%;height:auto}.diver{width:calc(28% * .88);left:18.5%;top:3.2%;transform:translate(var(--px),var(--py));animation:drift-a 6.5s ease-in-out infinite}.explorer{width:calc(19.3% * .88);left:46%;top:45.5%;transform:translate(calc(var(--px)*-.7),calc(var(--py)*-.7));animation:drift-b 7.4s ease-in-out infinite}.aligner{width:calc(24% * .88);right:6.5%;bottom:8.5%;transform:translate(calc(var(--px)*-.45),calc(var(--py)*-.45));animation:drift-a 8.2s ease-in-out infinite reverse}.synth{width:calc(24% * .88);left:13.5%;bottom:5.5%;transform:translate(calc(var(--px)*.5),calc(var(--py)*.5));animation:drift-b 6.8s ease-in-out infinite reverse}@keyframes drift-a{50%{translate:0 -7px}}@keyframes drift-b{50%{translate:0 6px}}@keyframes shimmer{0%,100%{transform:translateX(-18%);opacity:.15}50%{transform:translateX(18%);opacity:.48}}@media(max-width:700px){.home{min-height:560px;background-position:53% center}.home nav{top:1.2%;right:4%;gap:2vw}.home nav a:nth-child(1) img{width:11vw}.home nav a:nth-child(2) img{width:17vw}.home nav a:nth-child(3) img{width:10vw}.home nav a:nth-child(4) img{width:14vw}.copy{width:calc(44% * .88);left:6%;top:35%}.diver{width:calc(53% * .88);left:19%;top:5%}.explorer{width:calc(37% * .88);left:49%;top:48%}.aligner{width:calc(47% * .88);right:-3%;bottom:11%}.synth{width:calc(47% * .88);left:3%;bottom:5%}}@media(prefers-reduced-motion:reduce){.home:after,.identity{animation:none}.identity,.copy{transition:none}}</style>
