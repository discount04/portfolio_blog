<aside class="card" hidden><button aria-label="Close">×</button><h2></h2><p></p></aside></section>
<script>const home=document.querySelector('[data-home]'),items=[...document.querySelectorAll('.identity')],card=document.querySelector('.card'),close=()=>{home.classList.remove('selected');items.forEach(x=>x.setAttribute('aria-pressed','false'));card.hidden=true};items.forEach(x=>x.onclick=()=>{const same=x.getAttribute('aria-pressed')==='true';close();if(!same){home.classList.add('selected');x.setAttribute('aria-pressed','true');const [title,body]=x.getAttribute('aria-label').split(': ');card.querySelector('h2').textContent=title;card.querySelector('p').textContent=body;card.hidden=false}});card.querySelector('button').onclick=close;</script>
<style is:global>.site-header,footer{display:none}.home{position:relative;width:100vw;height:100vh;min-height:640px;overflow:hidden;isolation:isolate;background:url('/portfolio_blog/images/home-v3/bg.png') center/cover no-repeat}.home nav{position:absolute;z-index:10;top:.45%;right:4.15%;display:grid;justify-items:end;gap:1.05vw}.home nav a{display:block;line-height:0}.home nav a:hover{opacity:.7}.home nav img{display:block;height:auto}.home nav a:nth-child(1) img{width:5.1vw}.home nav a:nth-child(2) img{width:8vw}.home nav a:nth-child(3) img{width:4.6vw}.home nav a:nth-child(4) img{width:6.7vw}.copy{position:absolute;z-index:2;width:28%;left:5.5%;top:41%}.identity{position:absolute;z-index:3;margin:0;padding:0;border:0;background:transparent;cursor:pointer;transition:opacity .28s,filter .28s,transform .28s}.identity img{display:block;width:100%;height:auto}.diver{width:28%;left:18.5%;top:3.2%}.explorer{width:19.3%;left:46%;top:45.5%}.aligner{width:24%;right:6.5%;bottom:8.5%}.synth{width:24%;left:13.5%;bottom:5.5%}.identity:hover,.identity:focus,.identity[aria-pressed='true']{transform:scale(1.025)}.home.selected .identity:not([aria-pressed='true']){opacity:.26;filter:grayscale(.25)}.card{position:absolute;z-index:11;right:4.2%;bottom:5%;width:min(310px,25vw);padding:20px 42px 20px 22px;color:#111;background:rgba(255,255,255,.94);box-shadow:0 10px 24px #0003;font-family:'PingFang HK',sans-serif}.card h2{margin:0 0 9px;font:400 clamp(23px,2vw,34px)/1 'Instrument Serif',serif}.card p{margin:0;font-size:13px;line-height:1.55}.card button{position:absolute;top:7px;right:10px;border:0;background:transparent;font-size:28px;cursor:pointer}@media(max-width:700px){.home{min-height:560px;background-position:53% center}.home nav{top:1.2%;right:4%;gap:2vw}.home nav a:nth-child(1) img{width:11vw}.home nav a:nth-child(2) img{width:17vw}.home nav a:nth-child(3) img{width:10vw}.home nav a:nth-child(4) img{width:14vw}.copy{width:44%;left:6%;top:35%}.diver{width:53%;left:19%;top:5%}.explorer{width:37%;left:49%;top:48%}.aligner{width:47%;right:-3%;bottom:11%}.synth{width:47%;left:3%;bottom:5%}.card{right:5%;bottom:4%;width:min(270px,65vw)}}</style>
