---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSection from '../components/ProfileSection.astro';
---

<BaseLayout title="KORI.com — Product Designer" description="I dive deep, then spread what I discover.">
  <section class="figma-home" aria-label="Harin Park portfolio">
    <div class="figma-home-copy">
      <h1>HARIN PARK</h1>
    </div>
    <p class="figma-home-role">UXUI Designer<br />Portfolio</p>
    <a class="figma-scroll" href="#profile-section"><span>Scroll Down to know about ME!</span><b aria-hidden="true">⌄</b></a>
  </section>
  <ProfileSection id="profile-section" />
</BaseLayout>
