---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const items = [
  { title: 'Graphic Design Classes', type: 'University of Iowa', files: ['graphic-design-classes.png'] },
  { title: 'Christmas Party Poster & Brochure', type: 'Poster & Brochure', files: ['christmas-party-brochure.png'] },
  { title: 'Summer Camp Name Tag & Poster', type: 'Summer Camp', files: ['summer-camp-tag-poster.png'] },
  { title: 'Ewhaian Community Posters', type: 'Community Posters', files: ['ewhaian-posters-1.png', 'ewhaian-posters-2.png', 'ewhaian-posters-3.png'] },
];
---
<BaseLayout title="Playground — HARIN PARK">
  <section class="figma-playground" aria-labelledby="playground-heading">
    <h1 id="playground-heading">playground</h1>
    <div class="playground-list">
      {items.map((item, index) => (
        <button class="playground-row" type="button" data-gallery={index}>
          <span class="playground-type">{item.type}</span>
          <span class="playground-name">{item.title}</span>
          <span class="playground-open" aria-hidden="true">↗</span>
        </button>
      ))}
      <a class="playground-row instagram-row" href="https://www.instagram.com/digo.ada/" target="_blank" rel="noreferrer">
        <span class="playground-type">Instagram</span><span class="playground-name">@digo.ada with Designer Friends</span><span class="playground-open" aria-hidden="true">↗</span>
      </a>
    </div>
    <dialog class="artwork-dialog" aria-label="Design artwork"><button class="dialog-close" type="button" aria-label="Close">×</button><div class="dialog-gallery"></div></dialog>
  </section>
  <script define:vars={{ items, base }}>
    const dialog = document.querySelector('.artwork-dialog');
    const gallery = dialog?.querySelector('.dialog-gallery');
    document.querySelectorAll('[data-gallery]').forEach((button) => button.addEventListener('click', () => {
      if (!dialog || !gallery) return;
      gallery.innerHTML = '';
      const item = items[Number(button.dataset.gallery)];
      item.files.forEach((file) => { const img = document.createElement('img'); img.src = `${base}images/playground/${file}`; img.alt = item.title; gallery.append(img); });
      dialog.showModal();
    }));
    dialog?.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</BaseLayout>
