---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const imagePath = (name: string) => `${base}images/journal-figma/${name}`;
const postPath = (id: string) => `${base}journal/${id}/`;
---

<BaseLayout title="Blogs — KORI">
  <section class="journal-editorial" aria-labelledby="journal-heading">
    <h1 id="journal-heading" class="journal-wordmark">blogs</h1>

    <div class="journal-art" aria-label="블로그와 연결된 이미지">
      <a class="journal-artpiece journal-art-screen" href={imagePath('blog-poster-photo.jpg')} target="_blank" rel="noreferrer" aria-label="크리스마스 포스터 사진 크게 보기">
        <img class="poster-underlay" src={imagePath('screenshot-layer.png')} alt="" />
        <img src={imagePath('blog-poster-photo.jpg')} alt="크리스마스 익스프레스 포스터가 벽에 붙어 있는 사진" />
      </a>
      <a class="journal-artpiece journal-art-tag" href={imagePath('name-tag.png')} target="_blank" rel="noreferrer" aria-label="그래픽 이미지 크게 보기">
        <img class="tag-ellipse tag-ellipse-top" src={imagePath('ellipse-2.svg')} alt="" />
        <img class="tag-ellipse tag-ellipse-bottom" src={imagePath('ellipse-1.svg')} alt="" />
        <span class="tag-cell cell-one"></span><span class="tag-cell cell-two"></span>
        <span class="tag-cell cell-three"></span><span class="tag-cell cell-four"></span>
        <span class="tag-cell cell-five"></span><span class="tag-cell cell-six"></span>
        <span class="tag-cell cell-seven"></span><span class="tag-cell cell-eight"></span>
        <span class="tag-cell cell-nine"></span><span class="tag-cell cell-ten"></span>
        <img class="tag-icon tag-water-one" src={imagePath('water.png')} alt="" />
        <img class="tag-icon tag-rainbow" src={imagePath('rainbow.png')} alt="" />
        <img class="tag-icon tag-bug" src={imagePath('bug.png')} alt="" />
        <img class="tag-icon tag-water-two" src={imagePath('water.png')} alt="" />
        <img class="tag-icon tag-ellipse-four-one" src={imagePath('ellipse-4.svg')} alt="" />
        <img class="tag-icon tag-ellipse-four-two" src={imagePath('ellipse-4.svg')} alt="" />
        <img class="tag-icon tag-vector-one" src={imagePath('vector-3.svg')} alt="" />
        <img class="tag-icon tag-balloon" src={imagePath('party-balloon.png')} alt="" />
        <img class="tag-icon tag-apple" src={imagePath('whole-apple.png')} alt="" />
        <img class="tag-icon tag-vector-two" src={imagePath('vector-3.svg')} alt="" />
        <img class="tag-icon tag-dog-one" src={imagePath('dog.png')} alt="" />
        <img class="tag-icon tag-dog-two" src={imagePath('dog.png')} alt="" />
        <span class="tag-team">3조</span>
        <img class="tag-character" src={imagePath('name-tag.png')} alt="노란 강아지 캐릭터 일러스트" />
        <span class="tag-names">두윤아 안나</span>
      </a>
      <a class="journal-artpiece journal-art-brochure" href={imagePath('trifold-brochure.png')} target="_blank" rel="noreferrer" aria-label="크리스마스 브로슈어 이미지 크게 보기">
        <img src={imagePath('trifold-brochure.png')} alt="크리스마스 익스프레스 브로슈어와 티켓 디자인" />
      </a>
      <a class="journal-artpiece journal-art-phone" href={imagePath('phone-mockup.png')} target="_blank" rel="noreferrer" aria-label="앱 화면 이미지 크게 보기">
        <img src={imagePath('phone-mockup.png')} alt="차량 이동 안내 앱 화면 목업" />
      </a>
    </div>

    <div class="journal-entries">
      {posts.map((post) => (
        <article class="journal-entry">
          <span class="journal-category">{post.data.category}</span>
          <div class="journal-copy">
            <a class="journal-title-link" href={postPath(post.id)}>
              <h2>{post.data.title}</h2>
            </a>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('ko-KR')}
            </time>
            <p>{post.data.description}</p>
          </div>
        </article>
      ))}

      <article class="journal-entry journal-instagram-entry">
        <span class="journal-category">Instagram</span>
        <div class="journal-copy">
          <a class="journal-title-link" href="https://www.instagram.com/digo.ada/" target="_blank" rel="noreferrer">
            <h2>@digo.ada with Designer Friends <span aria-hidden="true">↗</span></h2>
          </a>
          <p class="journal-instagram-label">Instagram</p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
