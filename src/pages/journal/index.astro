---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Journal — KORI">
  <section class="listing-hero journal-title">
    <p class="eyebrow">02 / JOURNAL</p>
    <h1>완성된 답보다<br />생각이 바뀐 흔적.</h1>
  </section>
  <section class="journal-index">
    {posts.map((post) => (
      <a href={`/journal/${post.id}/`}>
        <span class="tag">{post.data.category}</span>
        <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
        <time>{post.data.date.toLocaleDateString('ko-KR')}</time>
      </a>
    ))}
  </section>
</BaseLayout>
